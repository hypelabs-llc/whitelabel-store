.vs
.vscode
.idea
.claude
**/.DS_Store
*.DotSettings.user

# Node / Next.js build artifacts (ignored at any depth)
node_modules/
.next/
out/
build/
*.tsbuildinfo
# Generated by Next on dev/build; its import path flips between .next/types and .next/dev/types,
# so tracking it just produces a perpetual diff. Next regenerates it on every run.
next-env.d.ts

# Env files (never commit secrets, e.g. the Partner API key)
.env
.env.*
!.env.example

# Archived Vite frontend source (v1) — ignored during the Next.js migration
src/v1
.vercel
